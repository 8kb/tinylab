{
  "_comment": "Tiny end-to-end pipeline, sized to run on a laptop in minutes. sequence_len:2048 and core's max_per_task:24 aren't arbitrary -- see AGENTS.md's 'Invariants that will bite you'.",
  "defaults": {
    "device": "auto",
    "sequence_len": 2048,
    "model": { "preset": "gpt", "depth": 4, "aspect_ratio": 64 }
  },
  "steps": [
    { "name": "data", "op": "prepare", "kind": "base", "shards": 2 },
    { "name": "pre", "op": "train", "kind": "base", "num_iterations": 30, "device_batch_size": 1,
      "total_batch_size": 2048, "eval_every": 10, "eval_tokens": 2048 },
    { "name": "sftdata", "op": "prepare", "kind": "sft", "max_conversations": 200, "mmlu_epochs": 1, "gsm8k_epochs": 1 },
    { "name": "sft", "op": "train", "kind": "sft", "source_tag": "pre", "num_iterations": 20,
      "device_batch_size": 1, "total_batch_size": 2048, "eval_every": 10, "eval_tokens": 2048 },
    { "name": "core", "op": "bench", "suite": "core", "source": "sft", "model_tag": "sft", "max_per_task": 24 }
  ],
  "chat": { "source": "sft", "model_tag": "sft", "temperature": 0.6, "top_k": 50, "max_tokens": 128 }
}
