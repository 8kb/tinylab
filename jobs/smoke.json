{
  "_comment": "Tiny end-to-end pipeline, sized to run on a laptop in minutes. sequence_len:2048 and core's max_per_task:24 aren't arbitrary -- see AGENTS.md's 'Invariants that will bite you'. configs/nanogpt_d4.json was generated by `llmllab/tools/make_config.py --arch gpt --depth 4` -- tinylab does no preset/depth derivation of its own, see AGENTS.md. After training it runs the non-score bench suites (bpb, sample, tokenizer) and a 2-step rl on GSM8K (downloaded on first use) to check the plumbing; the `infer` suite is CUDA-only and not part of it.",
  "defaults": {
    "device": "auto",
    "sequence_len": 2048,
    "world_size": 1,
    "model_config": "configs/nanogpt_d4.json",
    "experiment": "scratch"
  },
  "steps": [
    { "name": "data", "op": "prepare", "kind": "base", "shards": 2 },
    { "name": "pre", "op": "train", "kind": "base", "num_iterations": 30, "device_batch_size": 1,
      "total_batch_size": 2048, "eval_every": 10, "eval_tokens": 2048 },
    { "name": "sftdata", "op": "prepare", "kind": "sft", "max_conversations": 200, "mmlu_epochs": 1, "gsm8k_epochs": 1 },
    { "name": "sft", "op": "train", "kind": "sft", "source_tag": "pre", "num_iterations": 20,
      "device_batch_size": 1, "total_batch_size": 2048, "eval_every": 10, "eval_tokens": 2048 },
    { "name": "core", "op": "bench", "suite": "core", "model_tag": "sft", "max_per_task": 24 },
    { "name": "bpb", "op": "bench", "suite": "bpb", "model_tag": "pre", "split_tokens": 8192, "device_batch_size": 1 },
    { "name": "sample", "op": "bench", "suite": "sample", "model_tag": "sft", "prompts": ["The capital of France is"], "max_new_tokens": 16 },
    { "name": "tokcmp", "op": "bench", "suite": "tokenizer" },
    { "name": "rl", "op": "rl", "source_tag": "sft", "num_iterations": 2, "examples_per_step": 2, "num_samples": 2,
      "device_batch_size": 2, "max_new_tokens": 16, "eval_every": 1, "eval_examples": 2, "save_every": 2 }
  ],
  "chat": { "model_tag": "sft", "temperature": 0.6, "top_k": 50, "max_tokens": 128 }
}
